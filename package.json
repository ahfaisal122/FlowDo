{
  "name": "flowdo",
  "version": "1.0.0",
  "description": "A minimal task manager",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "build": "unset ELECTRON_RUN_AS_NODE && electron-builder --mac",
